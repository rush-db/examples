{
  "protocolVersion": 1,
  "operation": {
    "kind": "query",
    "query": {
      "kind": "records",
      "query": {
        "labels": [
          "PERSON"
        ],
        "predicate": {
          "born": {
            "$lt": "1920-01-01"
          },
          "died": {
            "$exists": false
          }
        },
        "select": {
          "name": "$record.name"
        }
      }
    }
  }
}
