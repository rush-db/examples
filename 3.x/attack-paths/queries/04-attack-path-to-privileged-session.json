{
  "protocolVersion": 1,
  "operation": {
    "kind": "query",
    "query": {
      "kind": "records",
      "query": {
        "labels": [
          "USER"
        ],
        "predicate": {
          "privileged": false,
          "GROUP": {
            "$relation": {
              "type": "MEMBER_OF",
              "direction": "out",
              "hops": {
                "min": 1,
                "max": 6
              }
            },
            "COMPUTER": {
              "$relation": {
                "type": "ADMIN_TO",
                "direction": "out"
              },
              "USER": {
                "$relation": {
                  "type": "HAS_SESSION",
                  "direction": "out"
                },
                "privileged": true
              }
            }
          }
        },
        "order": {
          "username": "asc"
        }
      }
    }
  }
}
