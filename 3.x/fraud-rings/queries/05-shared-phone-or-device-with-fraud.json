{
  "protocolVersion": 1,
  "operation": {
    "kind": "query",
    "query": {
      "kind": "records",
      "query": {
        "labels": [
          "APPLICATION"
        ],
        "predicate": {
          "status": {
            "$ne": "confirmed_fraud"
          },
          "$or": [
            {
              "PHONE": {
                "APPLICATION": {
                  "status": "confirmed_fraud"
                }
              }
            },
            {
              "DEVICE": {
                "APPLICATION": {
                  "status": "confirmed_fraud"
                }
              }
            }
          ]
        },
        "order": {
          "applicationId": "asc"
        }
      }
    }
  }
}
